{
  "entities": {
    "tournament": {
      "title": "Tournament",
      "description": "Esports tournament record with state machine lifecycle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "game": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["REGISTRATION", "CAPTAINS", "AUCTION", "MATCHES", "COMPLETED"] },
        "prizePool": { "type": "string", "maxLength": 64 },
        "prizePoolNumber": { "type": "number" },
        "teamCount": { "type": "number" },
        "slotsPerTeam": { "type": "number" },
        "startingCredits": { "type": "number" },
        "minBid": { "type": "number" },
        "bidIncrement": { "type": "number" },
        "bidTimerSeconds": { "type": "number" },
        "organizer": { "type": "string", "maxLength": 100 },
        "organizerId": { "type": "string", "maxLength": 128 },
        "organizerEmail": { "type": "string", "maxLength": 128 },
        "city": { "type": "string", "maxLength": 64 },
        "region": { "type": "string", "maxLength": 64 },
        "dates": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "game", "status", "organizerId"]
    },
    "tournamentRegistration": {
      "title": "TournamentRegistration",
      "description": "Registered player record for a tournament",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tournamentId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "ign": { "type": "string", "maxLength": 64 },
        "mmr": { "type": "number" },
        "primaryRole": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 64 },
        "isCaptainApplicant": { "type": "boolean" },
        "isCaptainAppointed": { "type": "boolean" },
        "teamId": { "type": "string", "maxLength": 128 },
        "registeredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tournamentId", "userId", "ign", "mmr", "primaryRole"]
    },
    "franchiseTeam": {
      "title": "FranchiseTeam",
      "description": "Appointed captain franchise squad for a tournament",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tournamentId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "tag": { "type": "string", "maxLength": 16 },
        "logo": { "type": "string", "maxLength": 64 },
        "color": { "type": "string", "maxLength": 32 },
        "captainUserId": { "type": "string", "maxLength": 128 },
        "captainIgn": { "type": "string", "maxLength": 64 },
        "startingCredits": { "type": "number" },
        "remainingCredits": { "type": "number" },
        "creditsUsed": { "type": "number" },
        "roster": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["id", "tournamentId", "name", "tag", "captainUserId", "captainIgn"]
    },
    "auctionState": {
      "title": "AuctionState",
      "description": "Real-time state of the live player auction floor",
      "type": "object",
      "properties": {
        "tournamentId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["IDLE", "BIDDING", "PAUSED", "SOLD", "UNSOLD", "COMPLETED"] },
        "currentBid": { "type": "number" },
        "leadingTeamId": { "type": "string", "maxLength": 128 },
        "leadingTeamName": { "type": "string", "maxLength": 100 },
        "leadingCaptainIgn": { "type": "string", "maxLength": 64 },
        "secondsRemaining": { "type": "number" },
        "timerDeadline": { "type": "number" },
        "bidHistory": {
          "type": "array",
          "items": { "type": "object" }
        },
        "soldPlayerIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unsoldPlayerIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "revision": { "type": "number" }
      },
      "required": ["tournamentId", "status", "currentBid", "revision"]
    },
    "tournamentMatch": {
      "title": "TournamentMatch",
      "description": "Championship match in tournament bracket",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tournamentId": { "type": "string", "maxLength": 128 },
        "round": { "type": "number" },
        "matchNumber": { "type": "number" },
        "teamA": { "type": "object" },
        "teamB": { "type": "object" },
        "winnerTeamId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["SCHEDULED", "LIVE", "COMPLETED"] }
      },
      "required": ["id", "tournamentId", "round", "status"]
    },
    "steamIdentityClaim": {
      "title": "SteamIdentityClaim",
      "description": "1:1 authoritative Steam account ownership claim",
      "type": "object",
      "properties": {
        "steamId64": { "type": "string", "maxLength": 17 },
        "dotaAccountId": { "type": "string", "maxLength": 10 },
        "userId": { "type": "string", "maxLength": 128 },
        "verificationMethod": { "type": "string" },
        "verifiedAt": { "type": "number" }
      },
      "required": ["steamId64", "dotaAccountId", "userId", "verificationMethod", "verifiedAt"]
    },
    "privatePlayerAccount": {
      "title": "PrivatePlayerAccount",
      "description": "Private Steam & Dota player identity verification record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "steamId64": { "type": "string" },
        "steamId32": { "type": "string" },
        "dotaAccountId": { "type": "string" },
        "verificationStatus": { "type": "string" },
        "steamOwnershipVerified": { "type": "boolean" },
        "steamPersonaName": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "verificationStatus", "steamOwnershipVerified", "updatedAt"]
    },
    "userRole": {
      "title": "UserRole",
      "description": "Role-based access control assignment record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "organizer", "moderator", "captain"] },
        "assignedBy": { "type": "string", "maxLength": 128 },
        "assignedAt": { "type": "string", "format": "date-time" },
        "displayName": { "type": "string", "maxLength": 100 },
        "pbgId": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["ACTIVE", "REVOKED"] }
      },
      "required": ["email", "role", "assignedBy", "assignedAt"]
    },
    "roleAuditLog": {
      "title": "RoleAuditLog",
      "description": "Security audit record of RBAC role mutations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "enum": ["ROLE_ASSIGNED", "ROLE_REVOKED", "ROLE_UPDATED"] },
        "targetEmail": { "type": "string", "maxLength": 128 },
        "targetRole": { "type": "string", "maxLength": 32 },
        "previousRole": { "type": "string", "maxLength": 32 },
        "performedBy": { "type": "string", "maxLength": 128 },
        "performedByEmail": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "action", "targetEmail", "targetRole", "performedBy", "performedByEmail", "timestamp"]
    }
  },
  "firestore": {
    "/tournaments/{tournamentId}": {
      "schema": "#/entities/tournament",
      "description": "Root tournament records"
    },
    "/tournaments/{tournamentId}/registrations/{userId}": {
      "schema": "#/entities/tournamentRegistration",
      "description": "Registered player contenders"
    },
    "/tournaments/{tournamentId}/teams/{teamId}": {
      "schema": "#/entities/franchiseTeam",
      "description": "Confirmed franchise teams and rosters"
    },
    "/tournaments/{tournamentId}/matches/{matchId}": {
      "schema": "#/entities/tournamentMatch",
      "description": "Bracket matches"
    },
    "/auctions/{auctionId}": {
      "schema": "#/entities/auctionState",
      "description": "Live auction floor state"
    },
    "/steamIdentityClaims/{steamId64}": {
      "schema": "#/entities/steamIdentityClaim",
      "description": "1:1 Steam account identity claims"
    },
    "/privatePlayerAccounts/{userId}": {
      "schema": "#/entities/privatePlayerAccount",
      "description": "Private Steam verification state"
    },
    "/user_roles/{roleDocId}": {
      "schema": "#/entities/userRole",
      "description": "Role-based access control assignments"
    },
    "/role_audit_logs/{logId}": {
      "schema": "#/entities/roleAuditLog",
      "description": "Immutable security logs of administrative role grants and revocations"
    }
  }
}

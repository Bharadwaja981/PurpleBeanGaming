rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == '11106cm009@gmail.com' ||
        request.auth.uid == '11106cm009@gmail.com'
      );
    }

    // 1. Tournaments Collection and subcollections (Public read, authenticated / admin write)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 2. Auctions (Live bidding state)
    match /auctions/{auctionId} {
      allow read, write: if true;
    }

    // 3. Teams Collection
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // 4. Registrations Collection
    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    // 5. Matches Collection
    match /matches/{matchId} {
      allow read, write: if true;
    }

    // 6. Users & Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    match /publicPlayers/{playerId} {
      allow read, write: if true;
    }

    match /privatePlayerAccounts/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 7. Steam OpenID 2.0 1:1 Identity Claims (Server authoritative)
    match /steamIdentityClaims/{steamId64} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 8. User Roles & RBAC (Read: isSignedIn; Write: isAdmin)
    match /user_roles/{roleDocId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 9. Role Audit Logs (Read/Write: isAdmin)
    match /role_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

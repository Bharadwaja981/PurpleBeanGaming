rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == '11106cm009@gmail.com' ||
        request.auth.uid == '11106cm009@gmail.com'
      );
    }

    function isStaffOrOrganizer() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'organizer' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == '11106cm009@gmail.com' ||
        request.auth.token.email == 'neelapuharsha@gmail.com'
      );
    }

    function isTournamentOwner(tournamentId) {
      return isSignedIn() && (
        isStaffOrOrganizer() ||
        (resource != null && (
          resource.data.organizer == request.auth.uid ||
          resource.data.organizerId == request.auth.uid ||
          resource.data.organizerEmail == request.auth.token.email
        ))
      );
    }

    // 1. Tournaments Collection and subcollections (Public read, authenticated / organiser write)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isTournamentOwner(tournamentId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['competitionStructure', 'competitionStructureSummary'])
      );
      allow delete: if isStaffOrOrganizer();

      // Competition structures (strictly server-authoritative via Cloud Functions; direct client writes disabled for all client accounts)
      match /competition/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Matches subcollection if present (strictly server-authoritative via Cloud Functions; direct client writes disabled)
      match /matches/{matchId} {
        allow read: if true;
        allow write: if false;
      }

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isStaffOrOrganizer();
      }
    }

    // 2. Auctions (Live bidding state)
    match /auctions/{auctionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 3. Teams Collection
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isStaffOrOrganizer() || isSignedIn();
    }

    // 4. Registrations Collection
    match /registrations/{registrationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 5. Matches Collection (Public read, server-authoritative writes via Cloud Functions only)
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // 6. Users & Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    match /publicPlayers/{playerId} {
      allow read, write: if true;
    }

    match /privatePlayerAccounts/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 7. Steam OpenID 2.0 1:1 Identity Claims (Server authoritative)
    match /steamIdentityClaims/{steamId64} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 8. User Roles & RBAC (Read: isSignedIn; Write: isAdmin)
    match /user_roles/{roleDocId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 9. Role Audit Logs (Read/Write: isAdmin)
    match /role_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

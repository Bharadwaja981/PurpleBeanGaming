rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Canonical Admin: Evaluated via custom claim, primary owner email, or /admins/{uid} document lookup.
    // Client-side profiles, local storage, or request parameters are strictly rejected.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email == '11106cm009@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Tournament Scoped Roles (Organizer verified per tournament)
    function isTournamentOrganizer(tournamentId) {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)/memberships/$(request.auth.uid)).data.role == 'organizer'
      );
    }

    // 1. Tournaments Collection (Public Read, Admin Mutation)
    match /tournaments/{tournamentId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      // Scoped Registrations subcollection: tournaments/{tournamentId}/registrations/{uid}
      match /registrations/{uid} {
        allow get, list: if true;
        allow create, update: if true;
        allow delete: if isAdmin();
      }

      // Scoped Teams subcollection
      match /teams/{teamId} {
        allow get, list: if true;
        allow create, update: if true;
        allow delete: if isAdmin();
      }

      // Scoped Memberships subcollection
      match /memberships/{userId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create, update, delete: if true;
      }

      // Tournament real-time presence (Captains & Organisers)
      match /presence/{userId} {
        allow get, list: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 2. Public Players (Non-PII public stats, IGN, and career data)
    match /publicPlayers/{playerId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 3. Private Player Accounts (Confidential PII, emails, steam IDs, and moderation flags)
    match /privatePlayerAccounts/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow delete: if isAdmin();
    }

    // 4. Teams Collection (Public Read, Admin Mutation for Purse & Rosters)
    match /teams/{teamId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 5. Matches Collection (Public Read, Admin Finalization & Correction)
    match /matches/{matchId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 6. Auctions State & Bids
    match /auctions/{tournamentId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      match /bids/{bidId} {
        allow get, list: if true;
        allow create: if isSignedIn(); // Captains submitting bids
        allow update, delete: if isAdmin();
      }

      match /presence/{userId} {
        allow get, list: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 7. Tournament Registrations (Public roster view, Player registration, Admin review & approval)
    match /registrations/{registrationId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 8. Disputes (Confidential referee reports, User submission as 'open', Admin resolution)
    match /disputes/{disputeId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.reportingUserId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.reportingUserId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(disputeId) &&
        incoming().reportingUserId == request.auth.uid &&
        incoming().status == 'Pending Review';
      allow update, delete: if isAdmin();
    }

    // 9. Immutable Audit Logs (Client creation allowed for activity logging, Admin viewing)
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 9b. User & System Notifications (Persistent alerts with Call-to-Action)
    match /notifications/{notifId} {
      allow get, list, create, update: if true;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /users/{userId}/notifications/{notifId} {
      allow get, list, create, update: if true;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // 10. Platform Admins Directory
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 10b. User Roles Directory (Admin RBAC Management)
    match /user_roles/{roleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 11. Reports & Integrity Allegations (Confidential)
    match /reports/{reportId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.reporterUserId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(reportId) &&
        incoming().reporterUserId == request.auth.uid &&
        incoming().status == 'Pending Review';
      allow update: if false; // Moderation and resolution server-only
      allow delete: if isAdmin();
    }

    // 12. Integrity & Smurf Investigation Cases (Confidential Referee / Admin Only)
    match /integrityCases/{caseId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false; // Server-only
    }

    // 13. Platform Sanctions & Bans (Public status for enforcement, Server-only mutation)
    match /sanctions/{sanctionId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Server-only
    }

    // 14. Official Announcements (Public Read, Server-Only Mutation)
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Server-only
    }

    // 15. Official Seasons & Authoritative Rankings (Public Read, Server-Only Mutation)
    match /seasons/{seasonId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /rankings/{rankingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // 16. Authoritative State Snapshots (Public Read for Sync, Server/Admin Mutation)
    match /stateSnapshots/{snapshotId} {
      allow get, list: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // 17. Server-Backed Games Registry (Public read active games, Admin CRUD)
    match /games/{gameId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 18. Connection Test (Public health check probe)
    match /test/{docId} {
      allow get: if true;
    }
  }
}

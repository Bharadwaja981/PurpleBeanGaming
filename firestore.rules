rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Canonical Admin: Evaluated via custom claim or /admins/{uid} document lookup.
    // Client-side profiles, local storage, or request parameters are strictly rejected.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Tournament Scoped Roles (Organizer verified per tournament)
    function isTournamentOrganizer(tournamentId) {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)/memberships/$(request.auth.uid)).data.role == 'organizer'
      );
    }

    // 1. Tournaments Collection (Public Read, Server-Only Mutation)
    match /tournaments/{tournamentId} {
      allow get, list: if true;
      // Clients CANNOT directly create, update status, or delete tournaments
      allow create, update, delete: if false;

      // Scoped Memberships subcollection
      match /memberships/{userId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create, update, delete: if false; // Server authoritative only
      }
    }

    // 2. Public Players (Non-PII public stats, IGN, and career data)
    match /publicPlayers/{playerId} {
      allow get, list: if true;
      allow create, update: if (isAdmin() || isOwner(playerId)) && isValidId(playerId) &&
        incoming().username is string && incoming().username.size() <= 64;
      allow delete: if false;
    }

    // 3. Private Player Accounts (Confidential PII, emails, steam IDs, and moderation flags)
    match /privatePlayerAccounts/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow delete: if false;
    }

    // 4. Teams Collection (Public Read, Server-Only Mutation for Purse & Rosters)
    match /teams/{teamId} {
      allow get, list: if true;
      // Purse and roster mutations execute strictly on trusted server
      allow create, update, delete: if false;
    }

    // 5. Matches Collection (Public Read, Server-Only Finalization & Correction)
    match /matches/{matchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // 6. Auctions State & Bids (Public Read, Server-Only Atomic Execution)
    match /auctions/{tournamentId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Direct client bids and writes denied!

      match /bids/{bidId} {
        allow get, list: if true;
        allow create, update, delete: if false; // Bids committed strictly by trusted server
      }
    }

    // 7. Tournament Registrations (Player self-registration only as 'registered', Server-Only review)
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(registrationId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'registered'; // User can ONLY register as 'registered'
      allow update, delete: if false; // Approvals & rejections execute via server
    }

    // 8. Disputes (Confidential referee reports, User submission as 'open', Server-Only resolution)
    match /disputes/{disputeId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.reportingUserId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.reportingUserId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(disputeId) &&
        incoming().reportingUserId == request.auth.uid &&
        incoming().reason is string && incoming().reason.size() <= 500 &&
        incoming().status == 'open';
      allow update, delete: if false; // Resolution handled strictly by server referee
    }

    // 9. Immutable Audit Logs (SERVER-ONLY CREATION - Clients CANNOT create or alter audit logs!)
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false; // Clients strictly denied!
    }

    // 10. Platform Admins Directory (SERVER-ONLY CREATION - Clients cannot self-promote)
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false; // Clients cannot create admin memberships
    }

    // 11. Reports & Integrity Allegations (Confidential)
    match /reports/{reportId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.reporterUserId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(reportId) &&
        incoming().reporterUserId == request.auth.uid &&
        incoming().status == 'Pending Review';
      allow update, delete: if false; // Moderation and resolution server-only
    }

    // 12. Integrity & Smurf Investigation Cases (Confidential Referee / Admin Only)
    match /integrityCases/{caseId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false; // Server-only
    }

    // 13. Platform Sanctions & Bans (Public status for enforcement, Server-only mutation)
    match /sanctions/{sanctionId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Server-only
    }

    // 14. Official Announcements (Public Read, Server-Only Mutation)
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Server-only
    }

    // 15. Official Seasons & Authoritative Rankings (Public Read, Server-Only Mutation)
    match /seasons/{seasonId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /rankings/{rankingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // 16. Authoritative State Snapshots (Public Read for Sync, Server/Admin Mutation)
    match /stateSnapshots/{snapshotId} {
      allow get, list: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // 17. Server-Backed Games Registry (Public read active games, Admin CRUD)
    match /games/{gameId} {
      allow get: if true;
      allow list: if isAdmin() || (resource.data.active == true);
      allow create, update, delete: if isAdmin();
    }
  }
}

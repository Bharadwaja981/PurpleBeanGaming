# ==============================================================================
# Purple Bean Gaming — Vercel & Production Environment Variables
# ==============================================================================
# All variables prefixed with VITE_ are bundled by Vite and accessible in the client.
# Non-prefixed variables are server-only (used in Vercel Serverless Functions / Node server).
#
# NOTE: The project also includes a default fallback in `firebase-applet-config.json`.
# If you don't provide these variables in Vercel, the app will automatically use the bundled config.
# If you configure them in Vercel Dashboard, they will override the bundled values.

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Vercel Client-Side)
# Where to get: Firebase Console (https://console.firebase.google.com)
# -> Select Project -> Project Settings -> General -> "Your apps" (Web app)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyBXbW4wptQI_ny98vCEcHbdHJhsMgRYbv0"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0634745445.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0634745445"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-helloworld-3b15cdcf-4ce0-4040-9e96-73767517ade0"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0634745445.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="866955042948"
VITE_FIREBASE_APP_ID="1:866955042948:web:b4faf027f5552b1d90e2d1"
VITE_FIREBASE_OAUTH_CLIENT_ID="866955042948-mtiemau7sc6smf9mtp7m4vqumedhomau.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 2. Server-Side Keys (Optional / Advanced)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Optional. For Gemini API queries.
# Where to get: Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# OPENDOTA_API_KEY: Optional. For higher rate limits on OpenDota player MMR fetches.
# Where to get: OpenDota (https://www.opendota.com/api-keys)
OPENDOTA_API_KEY=""

# APP_URL: The canonical public URL of your Vercel deployment.
# Example: https://your-project.vercel.app
APP_URL=""

# Steam ownership verification (SERVER-ONLY — never prefix these with VITE_)
# Public origin used as the Steam OpenID realm, e.g. https://www.purplebeangaming.com
STEAM_OPENID_REALM="https://www.purplebeangaming.com"
# Long random secret used to sign the Steam OpenID state token.
STEAM_OPENID_STATE_SECRET=""
# Optional but recommended for Steam persona/avatar enrichment.
STEAM_WEB_API_KEY=""
# Existing OpenDota key, server-side only.
OPENDOTA_API_KEY=""

# Firebase Admin credentials for trusted Steam verification writes.
# Use ONE supported server credential strategy. On Vercel, the JSON env var is simplest.
FIREBASE_PROJECT_ID="gen-lang-client-0634745445"
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-helloworld-3b15cdcf-4ce0-4040-9e96-73767517ade0"
FIREBASE_SERVICE_ACCOUNT_JSON=""
